{
  "name": "agentic-coding-flywheel-setup",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @acfs/web dev",
    "build": "bun run --filter @acfs/web build",
    "start": "bun run --filter @acfs/web start",
    "lint": "bun run --filter '*' lint",
    "type-check": "bun run --filter '*' type-check",
    "clean": "rm -rf apps/*/node_modules packages/*/node_modules node_modules",
    "check-lessons": "bun run scripts/check-lessons.ts",
    "check-tool-ids": "bun run scripts/check-tool-ids.ts",
    "check-fallbacks": "bun run scripts/check-fallbacks.ts",
    "check-routes": "bun run scripts/check-routes.ts",
    "i18n:check": "bun run build && (bun run start & PID=$!; sleep 5; kill -0 $PID 2>/dev/null || { echo '❌ Server failed to start (port conflict?)'; exit 1; }; bun run scripts/check-i18n.ts; EXIT=$?; kill $PID 2>/dev/null; exit $EXIT)"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "dependencies": {
    "@vercel/speed-insights": "^1.3.1",
    "glob": "^13.0.1"
  }
}
